{
  "name": "@local/agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "description": "Safely assess portable Claude Code and Codex data for migration into DeepSeek Harness.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run check && pnpm run test && pnpm run build"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": ["darwin"]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-package-manifest": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@types/node": "^24.10.0",
    "tsdown": "^0.15.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
